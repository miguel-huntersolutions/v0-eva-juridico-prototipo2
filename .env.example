# Copia este archivo a .env.local y completa los valores.
# .env.local está en .gitignore: nunca subas secretos al repositorio.
#
# Atajo: `vercel link` + `vercel env pull .env.local --environment=preview`
# trae las variables no sensibles. Las marcadas como "Sensitive" en Vercel
# llegan vacías y hay que copiarlas a mano (Supabase / OpenAI dashboards).

# ── Supabase (requeridas) ────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://<ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Solo servidor. Salta RLS: la usan las rutas de administración en app/api.
SUPABASE_SERVICE_ROLE_KEY=

# ── OpenAI (requeridas para el asistente y "mejorar texto") ─────────
OPENAI_API_KEY=
# /api/assistant responde 500 si falta (se usa como metadata de traza).
OPENAI_ASSISTANT_WORKFLOW_ID=
# Vector store para file search de los agentes de investigación.
OPENAI_VECTOR_STORE_ID=

# ── Google OAuth por usuario (requeridas para plantillas y documentos) ─
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Debe estar registrada como redirect URI en el cliente OAuth de Google Cloud.
GOOGLE_REDIRECT_URI=http://localhost:3000/api/google/callback
# Opcional: ID de Shared Drive. Sin él, los archivos van al My Drive del usuario.
GOOGLE_DRIVE_ID=

# ── App ──────────────────────────────────────────────────────────────
# Base para redirects de login e invitaciones.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Opcional: emailRedirectTo del registro (app/auth/sign-up/page.tsx).
# NEXT_PUBLIC_DEV_SUPABASE_REDIRECT_URL=http://localhost:3000/dashboard
