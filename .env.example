# Copiar a .env.local y rellenar con valores reales. No commitear .env.local.
# Ver docs/env-config.md para descripción de cada variable.

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# OpenAI
OPENAI_API_KEY=
OPENAI_ASSISTANT_WORKFLOW_ID=
OPENAI_VECTOR_STORE_ID=
OPENAI_MODEL=gpt-4o
OPENAI_WORKFLOW_MODEL=gpt-4o

# Google (Drive, OAuth)
GOOGLE_DRIVE_ID=
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/google/callback
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
GOOGLE_PROJECT_ID=

# Opcionales (defaults en lib/app-config.ts)
# GOOGLE_DRIVE_TIMEOUT_MS=120000
# AI_CHAT_MAX_DURATION=60
# ASSISTANT_MAX_DURATION=60
# GENERATE_DOCUMENT_MAX_DURATION=120
